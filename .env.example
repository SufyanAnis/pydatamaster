# Copy this file to `.env` (repo root). Every value is optional.

# HTTP port for the API / production server
PORT=4000

# Secret used to sign login cookies. If omitted, one is generated and persisted in the DB.
JWT_SECRET=

# Initial admin account. Only used the first time the database is created.
ADMIN_EMAIL=admin@pydatamaster.io
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Site Admin

# AI Tutor. Anthropic (Claude) is the default provider; Gemini is supported too.
# Keys can also be entered from Admin -> Settings -> AI Tutor (stored in the DB).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
